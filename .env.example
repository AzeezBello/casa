# Copy to .env.local. With the three SUPABASE_* values unset, the app runs on sample data
# and viewing requests are not stored. Set all three or none: a partial config fails fast.

# Public site URL, used in metadata and in agent notification emails. Leave blank on Vercel
# to use the project's production URL; a bare domain like casa.ng gets https:// added.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project (Settings → API). Server-only: never prefix these with NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: email agents about viewing requests via Resend. The from-address domain must be verified in Resend.
RESEND_API_KEY=
NOTIFY_FROM_EMAIL="CASA <viewings@your-domain.ng>"
